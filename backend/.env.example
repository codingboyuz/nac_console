# Copy to .env and replace every <PLACEHOLDER>. Never commit a real .env.
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=true

DATABASE_URL=postgresql+asyncpg://nac:<DB_PASSWORD>@postgres:5432/nac
REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL / CELERY_RESULT_BACKEND default to REDIS_URL

# >= 32 random chars, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=<JWT_SECRET>
INTERNAL_API_TOKEN=<INTERNAL_API_TOKEN>

# AES-256-GCM vault keys: "kid:<base64 of 32 random bytes>", comma separated for rotation.
# python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CREDENTIAL_KEYS=k1:<BASE64_32_BYTE_KEY>
CREDENTIAL_ACTIVE_KEY_ID=k1

CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,backend
INTERNAL_ALLOWED_NETWORKS=127.0.0.1/32,172.16.0.0/12

# Controller/management station IPs used by the self-lockout guard
CONTROLLER_IPS=<CONTROLLER_IP>
SSH_STRICT_HOST_KEY=true
DEVICE_MAX_SESSIONS=2

DISCOVERY_MAX_PREFIX=22
DISCOVERY_ALLOWED_SUBNETS=<MGMT_SUBNET_CIDR>

NAC_FAIL_MODE=closed
NAC_QUARANTINE_VLAN=999
NAC_GUEST_VLAN=20
RADIUS_REFERENCE_SERVER_ENABLED=false

# Alert channels (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
WEBHOOK_SIGNING_SECRET=

# docker-compose only
POSTGRES_PASSWORD=<DB_PASSWORD>
